# GENERATED by tools/hydra_bind.py
SRC = ../../../fpga/rtl/hydra_fpga_uart.sv ../../../fpga/rtl/hydra_fpga_selftest.sv ../../../common/rtl/hydra_rst_sync.sv hydra_ecp5_evn_selftest.sv

# Rebuild on CONTENT: .srchash changes only when an input does -- the RTL,
# the pin constraints, this Makefile (the flags) or a tool version.
CONS  := hydra_ecp5_evn_selftest.lpf
PLAN  := ../../../plans/ecp5-evn-selftest.yaml
TOOLS := $(shell { sv2v --version; yosys -V; nextpnr-ecp5 --version; } 2>&1 | tr '\n' ' ')
SRCHASH := $(shell { echo '$(SRC) $(CONS) $(TOOLS)'; cat $(SRC) $(CONS) $(PLAN) Makefile; } | sha256sum | cut -c1-16)
$(shell [ "$$(cat .srchash 2>/dev/null)" = "$(SRCHASH)" ] || echo "$(SRCHASH)" > .srchash)

all: hydra_ecp5_evn_selftest.bit

hydra_ecp5_evn_selftest.v: $(SRC) .srchash
	sv2v $(SRC) > $@

hydra_ecp5_evn_selftest.json: hydra_ecp5_evn_selftest.v
	yosys -p 'read_verilog $<; synth_ecp5 -top hydra_ecp5_evn_selftest -json hydra_ecp5_evn_selftest.json'

# nextpnr is run WITHOUT --timing-allow-fail: a design that misses
# 12 MHz stops the build here.
hydra_ecp5_evn_selftest.config: hydra_ecp5_evn_selftest.json $(CONS) .srchash
	nextpnr-ecp5 --um5g-85k --package CABGA381 --json hydra_ecp5_evn_selftest.json --lpf hydra_ecp5_evn_selftest.lpf --textcfg hydra_ecp5_evn_selftest.config --freq 12 --seed 1

hydra_ecp5_evn_selftest.bit: hydra_ecp5_evn_selftest.config
	ecppack hydra_ecp5_evn_selftest.config hydra_ecp5_evn_selftest.bit
	cp .srchash hydra_ecp5_evn_selftest.bit.srchash
	{ echo "image   $$(sha256sum hydra_ecp5_evn_selftest.bit)"; echo "srchash $(SRCHASH)"; echo "tools   $(TOOLS)"; echo "built   $$(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo "seed    1"; sha256sum $(SRC) $(CONS) $(PLAN) Makefile; } > hydra_ecp5_evn_selftest.bit.manifest

provenance:
	@if [ "$$(cat hydra_ecp5_evn_selftest.bit.srchash 2>/dev/null)" = "$(SRCHASH)" ]; then echo "hydra_ecp5_evn_selftest.bit: built from the current sources ($(SRCHASH))"; else echo "hydra_ecp5_evn_selftest.bit: STALE or unknown -- sources are $(SRCHASH), bitstream records $$(cat hydra_ecp5_evn_selftest.bit.srchash 2>/dev/null || echo nothing)"; exit 1; fi

clean:
	rm -f hydra_ecp5_evn_selftest.v hydra_ecp5_evn_selftest.json hydra_ecp5_evn_selftest.config hydra_ecp5_evn_selftest.bit hydra_ecp5_evn_selftest.bit.srchash hydra_ecp5_evn_selftest.bit.manifest .srchash
