# Rebuild on CONTENT: .srchash changes only when the sources do.
SRCHASH := $(shell { echo '$(SRC)'; cat $(SRC); } | sha256sum | cut -c1-16)
$(shell [ "$$(cat .srchash 2>/dev/null)" = "$(SRCHASH)" ] || echo "$(SRCHASH)" > .srchash)

all: hydra_ecp5_evn_selftest.bit

hydra_ecp5_evn_selftest.v: $(SRC) .srchash
	sv2v $(SRC) > $@

hydra_ecp5_evn_selftest.json: hydra_ecp5_evn_selftest.v
	yosys -p 'read_verilog $<; synth_ecp5 -top hydra_ecp5_evn_selftest -json hydra_ecp5_evn_selftest.json'

hydra_ecp5_evn_selftest.config: hydra_ecp5_evn_selftest.json
	nextpnr-ecp5 --um5g-85k --package CABGA381 --json hydra_ecp5_evn_selftest.json --lpf hydra_ecp5_evn_selftest.lpf --textcfg hydra_ecp5_evn_selftest.config --freq 12

hydra_ecp5_evn_selftest.bit: hydra_ecp5_evn_selftest.config
	ecppack hydra_ecp5_evn_selftest.config hydra_ecp5_evn_selftest.bit
	cp .srchash hydra_ecp5_evn_selftest.bit.srchash

provenance:
	@if [ "$$(cat hydra_ecp5_evn_selftest.bit.srchash 2>/dev/null)" = "$(SRCHASH)" ]; then echo "hydra_ecp5_evn_selftest.bit: built from the current sources ($(SRCHASH))"; else echo "hydra_ecp5_evn_selftest.bit: STALE or unknown -- sources are $(SRCHASH), bitstream records $$(cat hydra_ecp5_evn_selftest.bit.srchash 2>/dev/null || echo nothing)"; exit 1; fi

