# Rebuild on CONTENT: .srchash changes only when an input does -- the RTL,
# the pin constraints, this Makefile (the flags) or a tool version.
CONS  := hydra_ecp5_evn_tt.lpf
PLAN  := ../../../plans/ecp5-evn.yaml
TOOLS := $(shell { sv2v --version; yosys -V; nextpnr-ecp5 --version; } 2>&1 | tr '\n' ' ')
SRCHASH := $(shell { echo '$(SRC) $(CONS) $(TOOLS)'; cat $(SRC) $(CONS) $(PLAN) Makefile; } | sha256sum | cut -c1-16)
$(shell [ "$$(cat .srchash 2>/dev/null)" = "$(SRCHASH)" ] || echo "$(SRCHASH)" > .srchash)

all: hydra_ecp5_evn_tt.bit

hydra_ecp5_evn_tt.v: $(SRC) .srchash
	sv2v $(SRC) > $@

hydra_ecp5_evn_tt.json: hydra_ecp5_evn_tt.v
	yosys -p 'read_verilog $<; synth_ecp5 -top hydra_ecp5_evn_tt -json hydra_ecp5_evn_tt.json'

# nextpnr is run WITHOUT --timing-allow-fail: a design that misses
# 12 MHz stops the build here.
hydra_ecp5_evn_tt.config: hydra_ecp5_evn_tt.json $(CONS) .srchash
	nextpnr-ecp5 --um5g-85k --package CABGA381 --json hydra_ecp5_evn_tt.json --lpf hydra_ecp5_evn_tt.lpf --textcfg hydra_ecp5_evn_tt.config --freq 12 --seed 1

hydra_ecp5_evn_tt.bit: hydra_ecp5_evn_tt.config
	ecppack hydra_ecp5_evn_tt.config hydra_ecp5_evn_tt.bit
	cp .srchash hydra_ecp5_evn_tt.bit.srchash
	{ echo "image   $$(sha256sum hydra_ecp5_evn_tt.bit)"; echo "srchash $(SRCHASH)"; echo "tools   $(TOOLS)"; echo "built   $$(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo "seed    1"; sha256sum $(SRC) $(CONS) $(PLAN) Makefile; } > hydra_ecp5_evn_tt.bit.manifest

provenance:
	@if [ "$$(cat hydra_ecp5_evn_tt.bit.srchash 2>/dev/null)" = "$(SRCHASH)" ]; then echo "hydra_ecp5_evn_tt.bit: built from the current sources ($(SRCHASH))"; else echo "hydra_ecp5_evn_tt.bit: STALE or unknown -- sources are $(SRCHASH), bitstream records $$(cat hydra_ecp5_evn_tt.bit.srchash 2>/dev/null || echo nothing)"; exit 1; fi

clean:
	rm -f hydra_ecp5_evn_tt.v hydra_ecp5_evn_tt.json hydra_ecp5_evn_tt.config hydra_ecp5_evn_tt.bit hydra_ecp5_evn_tt.bit.srchash hydra_ecp5_evn_tt.bit.manifest .srchash
