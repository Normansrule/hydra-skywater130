# Vendor constraint files are downloaded, not redistributed: import_boards.py
# records each file's URL and SHA-256, and boards/*.yaml holds the pin data
# derived from them.
fpga/vendor_refs/

# Generated build products
fpga/build/*/*.v
fpga/build/*/*.json
fpga/build/*/*.asc
fpga/build/*/*.config
fpga/build/*/*.bin
fpga/build/*/*.bit
fpga/build/*/*.fs
# Content hashes: .srchash is the current sources, <image>.srchash what a
# bitstream was built from. Local to each build tree, like the bitstream.
fpga/build/*/.srchash
fpga/build/*/*.srchash

# Simulation and formal scratch
common/tb/padmux_vectors.hex
**/sim_build/
**/*.vcd
**/results.xml
# Everything sby writes goes in a SUBFOLDER of the formal/ folder holding the
# .sby file: one per task (<file>_<task>/), and in newer sby a <file>/ folder
# holding status.sqlite -- which slipped past the per-task patterns and was
# committed on 2026-10-07. No formal/ folder has a real subfolder, so ignore
# them all. Several targets also write a converted <name>_sv2v.v beside it.
**/formal/*/
**/formal/*_sv2v.v

.venv/
__pycache__/
.pytest_cache/
*.pyc
