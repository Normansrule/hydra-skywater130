+                         A_RESULT = 7'h06, A_LASTWD = 7'h07, A_CALUPD = 7'h08,
+                         A_BUSY = 7'h09, A_FENCE = 7'h0A, A_PARAM = 7'h0B,
+                         A_GLOBAL = 7'h0C, A_INFO = 7'h0D;
