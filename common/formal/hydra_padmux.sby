# hydra_padmux formal: k-induction proof of P1-P10 plus a reachability cover.
# Parameters are small but non-trivial: NALT=3 is not a power of two, so the
# illegal-select path (code 3) is live. RESET_SEL is non-zero.
[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 12

[engines]
smtbmc yices

[script]
read -formal hydra_padmux.sv
chparam -set NPAD 3 -set NALT 3 -set SELW 2 -set RESET_SEL 6'b100110 hydra_padmux
prep -top hydra_padmux

[files]
../rtl/hydra_padmux.sv
