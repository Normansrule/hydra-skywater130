# Two proofs for the vault:
#   prove   -- its own invariants (sealing is one-way, a wipe clears all)
#   ni      -- non-interference: the host port carries no key bits.
#              BOUNDED to 24 cycles from power-up -- see key_vault_ni.sv
#              for why this is bounded and what that does and does not mean.
#   cover   -- the keys in the two copies really can differ, so `ni` is not
#              vacuous
[tasks]
prove
ni
cover

[options]
prove: mode prove
prove: depth 12
ni: mode bmc
ni: depth 16
cover: mode cover
cover: depth 12

[engines]
smtbmc yices

[script]
prove: read -formal key_vault_sv2v.v
prove: prep -top hydra_key_vault
ni: read -formal key_vault_sv2v.v
ni: prep -top key_vault_ni
cover: read -formal key_vault_sv2v.v
cover: prep -top key_vault_ni

[files]
key_vault_sv2v.v
